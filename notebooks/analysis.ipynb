# 1. Imports
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy.stats import mannwhitneyu, chi2_contingency

# 2. Load raw CSVs
orders = pd.read_csv("data/raw/olist_orders_dataset.csv")
order_items = pd.read_csv("data/raw/olist_order_items_dataset.csv")
customers = pd.read_csv("data/raw/olist_customers_dataset.csv")
products = pd.read_csv("data/raw/olist_products_dataset.csv")
reviews = pd.read_csv("data/raw/olist_order_reviews_dataset.csv")
payments = pd.read_csv("data/raw/olist_order_payments_dataset.csv")
sellers = pd.read_csv("data/raw/olist_sellers_dataset.csv")
category_translation = pd.read_csv("data/raw/product_category_name_translation.csv")

# 3. Audit data
print("orders shape:", orders.shape)
print("customers shape:", customers.shape)
print("products shape:", products.shape)
print("reviews shape:", reviews.shape)
print("orders null count:\n", orders.isna().sum())

# 4. Convert timestamps
orders["order_purchase_timestamp"] = pd.to_datetime(orders["order_purchase_timestamp"], errors="coerce")
orders["order_approved_at"] = pd.to_datetime(orders["order_approved_at"], errors="coerce")
orders["order_delivered_carrier_date"] = pd.to_datetime(orders["order_delivered_carrier_date"], errors="coerce")
orders["order_delivered_customer_date"] = pd.to_datetime(orders["order_delivered_customer_date"], errors="coerce")
orders["order_estimated_delivery_date"] = pd.to_datetime(orders["order_estimated_delivery_date"], errors="coerce")
reviews["review_creation_date"] = pd.to_datetime(reviews["review_creation_date"], errors="coerce")
reviews["review_answer_timestamp"] = pd.to_datetime(reviews["review_answer_timestamp"], errors="coerce")

# 5. Merge category translation
products = products.merge(category_translation, on="product_category_name", how="left")
products["product_category_name_english"] = products["product_category_name_english"].fillna("Unknown")

# 6. Feature engineering
orders["is_late"] = (orders["order_delivered_customer_date"] > orders["order_estimated_delivery_date"]).astype(int)
orders["days_vs_estimate"] = (orders["order_delivered_customer_date"] - orders["order_estimated_delivery_date"]).dt.days

# 7. Merge key tables
order_data = orders.merge(order_items, on="order_id", how="left")
order_data = order_data.merge(customers, on="customer_id", how="left")
order_data = order_data.merge(products[["product_id", "product_category_name_english"]], on="product_id", how="left")
order_data = order_data.merge(reviews[["order_id", "review_score"]], on="order_id", how="left")
payment_summary = payments.groupby("order_id")["payment_value"].sum().reset_index()
order_data = order_data.merge(payment_summary, on="order_id", how="left")

# 8. First-order flag and return flag
order_data = order_data.sort_values(["customer_unique_id", "order_purchase_timestamp"])
order_data["first_order_flag"] = order_data.groupby("customer_unique_id")["order_id"].cumcount() == 0
customer_order_counts = order_data.groupby("customer_unique_id")["order_id"].nunique().reset_index()
customer_order_counts.columns = ["customer_unique_id", "total_orders"]
order_data = order_data.merge(customer_order_counts, on="customer_unique_id", how="left")
order_data["returned"] = (order_data["total_orders"] > 1).astype(int)

# 9. EDA: monthly revenue
monthly_revenue = (
    order_data[order_data["order_status"] == "delivered"]
    .groupby(order_data["order_purchase_timestamp"].dt.to_period("M").astype(str))["price"]
    .sum()
    .reset_index()
    .rename(columns={"order_purchase_timestamp": "month", "price": "revenue"})
)
monthly_revenue["month"] = pd.to_datetime(monthly_revenue["month"])

plt.figure(figsize=(12, 6))
sns.lineplot(data=monthly_revenue, x="month", y="revenue")
plt.title("Monthly revenue trend")
plt.show()

# 10. EDA: review score late vs on-time
late_vs_ontime = (
    order_data[order_data["order_status"] == "delivered"]
    .groupby("is_late")["review_score"]
    .mean()
    .reset_index()
)

plt.figure(figsize=(8, 5))
sns.barplot(data=late_vs_ontime, x="is_late", y="review_score")
plt.xticks([0, 1], ["On time", "Late"])
plt.title("Average review score by delivery status")
plt.show()

# 11. EDA: late rate by state
state_late = (
    order_data[order_data["order_status"] == "delivered"]
    .groupby("customer_state")
    .agg(late_rate=("is_late", "mean"), delivered_orders=("order_id", "nunique"))
    .reset_index()
    .sort_values("late_rate", ascending=False)
)

plt.figure(figsize=(12, 6))
sns.barplot(data=state_late.head(10), x="late_rate", y="customer_state")
plt.title("Late rate by state")
plt.show()

# 12. Statistical tests
late_review = order_data.loc[(order_data["order_status"] == "delivered") & (order_data["is_late"] == 1), "review_score"].dropna()
ontime_review = order_data.loc[(order_data["order_status"] == "delivered") & (order_data["is_late"] == 0), "review_score"].dropna()
stat, p_value = mannwhitneyu(late_review, ontime_review)
print("Mann-Whitney U p-value:", p_value)

first_orders = order_data[order_data["first_order_flag"] == True].copy()
return_table = pd.crosstab(first_orders["is_late"], first_orders["returned"])
chi2, p_chi, _, _ = chi2_contingency(return_table)
print("Chi-square p-value:", p_chi)

# 13. RFM segmentation
customer_summary = (
    order_data[order_data["order_status"] == "delivered"]
    .groupby("customer_unique_id")
    .agg(
        recency_days=("order_purchase_timestamp", lambda x: (pd.Timestamp.now().normalize() - x.max().normalize()).days),
        frequency=("order_id", "nunique"),
        monetary=("price", "sum")
    )
    .reset_index()
)

customer_summary["recency_score"] = pd.qcut(customer_summary["recency_days"], q=5, labels=False, duplicates="drop")
customer_summary["frequency_score"] = pd.qcut(customer_summary["frequency"], q=5, labels=False, duplicates="drop")
customer_summary["monetary_score"] = pd.qcut(customer_summary["monetary"], q=5, labels=False, duplicates="drop")
customer_summary["rfm_segment"] = (
    customer_summary["recency_score"].astype(str)
    + "-"
    + customer_summary["frequency_score"].astype(str)
    + "-"
    + customer_summary["monetary_score"].astype(str)
)

# 14. Export cleaned files
order_data.to_csv("data/cleaned/clean_orders.csv", index=False)
customers.to_csv("data/cleaned/clean_customers.csv", index=False)
products.to_csv("data/cleaned/clean_products.csv", index=False)
customer_summary.to_csv("data/cleaned/rfm_segments.csv", index=False)

print("Notebook completed.")
